<mujoco model="desktop_table_lights">
  <compiler angle="radian" meshdir="./" texturedir="./" />
  <option timestep="0.002" />

  <asset>
    <texture name="groundplane" type="2d" builtin="checker" mark="edge"
             rgb1="0.3 0.4 0.5" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="2 2" reflectance="0.2" />
  </asset>

  <worldbody>
    <!-- 地面 -->
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane" />

    <!-- 顶光 -->
    <light name="top_light" pos="0 0 3" dir="0 0 -1" directional="true"
           diffuse="1 1 1" specular="0.3 0.3 0.3" />

    <!-- 桌面：放在 (0, 0, 0.4) 高度，桌面顶面 z=0.8 -->
    <body name="desk" pos="0 0 0" euler="0 0 0">
      <geom name="desk_top" type="box" size="0.5 0.4 0.02" pos="0 0 0.4"
            rgba="0.63 0.76 0.63 1.0" />
      <geom name="desk_leg1" type="box" size="0.02 0.02 0.2" pos="-0.45 -0.35 0.2"
            rgba="0.5 0.5 0.5 1" />
      <geom name="desk_leg2" type="box" size="0.02 0.02 0.2" pos="0.45 -0.35 0.2"
            rgba="0.5 0.5 0.5 1" />
      <geom name="desk_leg3" type="box" size="0.02 0.02 0.2" pos="-0.45 0.35 0.2"
            rgba="0.5 0.5 0.5 1" />
      <geom name="desk_leg4" type="box" size="0.02 0.02 0.2" pos="0.45 0.35 0.2"
            rgba="0.5 0.5 0.5 1" />
      <inertial pos="0 0 0.2" mass="10" diaginertia="0.1 0.1 0.1" />
    </body>
  </worldbody>
</mujoco>
